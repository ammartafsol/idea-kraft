# Public site URL — used for canonical URLs, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — contact form delivery.
# When set, every valid submission is POSTed as JSON to this URL
# (works with Slack/Discord incoming webhooks, Zapier, Make, n8n, or your own API).
# When unset, submissions are validated and logged to the server console.
# CONTACT_WEBHOOK_URL=

# MongoDB Atlas: stores page-view analytics and contact enquiries (admin panel).
# Use a separate database name for local development, e.g. /novara_dev.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/novara?retryWrites=true&w=majority

# Admin panel (/admin). Admin accounts are stored in MongoDB with hashed passwords.
# Create or reset one with: npm run admin:create   (add -- --env .env.vercel for production)
# ADMIN_SESSION_SECRET=<random string, 32+ characters; signs the login cookie>
