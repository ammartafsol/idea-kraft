# Public site URL — used for canonical URLs, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — contact form delivery.
# When set, every valid submission is POSTed as JSON to this URL
# (works with Slack/Discord incoming webhooks, Zapier, Make, n8n, or your own API).
# When unset, submissions are validated and logged to the server console.
# CONTACT_WEBHOOK_URL=
