# NestJS API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public media / S3 (or CDN) base URL for next/image + mediaURL
NEXT_PUBLIC_AWS_URL=https://example.s3.amazonaws.com

# Optional — Google Maps / Places
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — Socket.IO origin (defaults to NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
